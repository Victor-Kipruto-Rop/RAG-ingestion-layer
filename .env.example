APP_ENV=development
APP_NAME=PesaGuard Registry Datasource
DATABASE_URL=sqlite:///./registry.db
REGISTRY_API_KEYS=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=52428800
MAX_RECORDS_PER_FILE=1000000
INGESTION_BATCH_SIZE=5000
LOCAL_STORAGE_PATH=./.registry-uploads
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=30
WORKER_STALE_AFTER_SECONDS=900\nWORKER_STALE_AFTER_SECONDS=900
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
VITE_API_BASE_URL=http://localhost:8000

# Optional; leave blank for local development.
REDIS_URL=
HMAC_SHARED_SECRET=
REQUIRE_HMAC=false
HMAC_CLOCK_SKEW_SECONDS=300
HMAC_NONCE_TTL_SECONDS=600
REGISTRY_RATE_LIMIT_CAPACITY=60
REGISTRY_RATE_LIMIT_REFILL_PER_SECOND=1.0
REGISTRY_CACHE_TTL_SECONDS=300
REGISTRY_CACHE_NEGATIVE_TTL_SECONDS=30
METRICS_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
