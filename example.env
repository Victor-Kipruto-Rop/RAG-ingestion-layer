# SAFE LOCAL DEVELOPMENT DEFAULTS ONLY.
# Copy this file to .env for Windows local testing.
# Do not put production Supabase URLs, database passwords, or R2 keys here.
APP_ENV=development
APP_NAME=PesaGuard Registry Datasource
DATABASE_URL=sqlite:///./registry.db
# Replace with a long random LOCAL-ONLY key before starting the stack.
REGISTRY_API_KEYS=change-this-local-only-key-before-use
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800
MAX_DIRECT_UPLOAD_BYTES=5368709120
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
MAX_RECORDS_PER_FILE=1000000
INGESTION_BATCH_SIZE=5000
LOCAL_STORAGE_PATH=./.registry-uploads
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=30
WORKER_STALE_AFTER_SECONDS=900
WORKER_MAX_JOBS_PER_RUN=10
# Intentionally blank for local-only testing. The Windows compose file overrides
# database and storage paths and explicitly blanks these settings in containers.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
# Optional resilience controls; blank Redis means per-process rate-limit fallback and cache bypass.
REDIS_URL=
HMAC_SHARED_SECRET=
REQUIRE_HMAC=false
HMAC_CLOCK_SKEW_SECONDS=300
HMAC_NONCE_TTL_SECONDS=600
REGISTRY_RATE_LIMIT_CAPACITY=60
REGISTRY_RATE_LIMIT_REFILL_PER_SECOND=1.0
REGISTRY_CACHE_TTL_SECONDS=300
REGISTRY_CACHE_NEGATIVE_TTL_SECONDS=30
# Set a strong server-side token to expose the protected Prometheus endpoint.
METRICS_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
VITE_API_BASE_URL=http://localhost:8000
