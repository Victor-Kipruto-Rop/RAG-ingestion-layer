# Copy to .env. This file is local-only and must never be committed.
# Use a dedicated Supabase sandbox project and a private R2 sandbox bucket for development.
APP_ENV=development
APP_NAME=PesaGuard Registry Datasource

# Required: Supabase PostgreSQL connection string (not the Supabase anon/service-role key).
# Prefer the Supabase Session Pooler URL for app connections; URL-encode special characters
# in the database password and retain sslmode=require.
# Example shape:
# postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=

# Local API authentication key. Replace with a long random sandbox-only secret.
# Keep the matching secret in the PesaGuard Core API backend's server-side environment only.
REGISTRY_API_KEYS=replace-with-a-long-random-sandbox-only-secret
DATASOURCE_ENVIRONMENT=sandbox
DATASOURCE_ADMIN_TOKEN=
MANAGED_API_KEYS_ENABLED=true

# Browser dashboard -> local datasource API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare R2 (private bucket). Credentials are read by both API and worker.
# Use a dedicated sandbox bucket; do not point local workers at production objects.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional; if blank, the backend builds the standard endpoint from R2_ACCOUNT_ID.
R2_ENDPOINT_URL=

# Redis is a local container used for shared rate limits, cache and HMAC replay protection.
# Do not set localhost here; containers must reach the service by its Compose DNS name.
REDIS_URL=redis://registry-redis:6379/0
HMAC_SHARED_SECRET=
REQUIRE_HMAC=false
HMAC_CLOCK_SKEW_SECONDS=300
HMAC_NONCE_TTL_SECONDS=600
REGISTRY_RATE_LIMIT_CAPACITY=60
REGISTRY_RATE_LIMIT_REFILL_PER_SECOND=1.0
REGISTRY_CACHE_TTL_SECONDS=300
REGISTRY_CACHE_NEGATIVE_TTL_SECONDS=30

# Ingestion and upload limits.
MAX_UPLOAD_BYTES=52428800
MAX_DIRECT_UPLOAD_BYTES=5368709120
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
MAX_RECORDS_PER_FILE=1000000
INGESTION_BATCH_SIZE=5000
LOCAL_STORAGE_PATH=/app/.registry-uploads
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=30
WORKER_STALE_AFTER_SECONDS=900
WORKER_MAX_JOBS_PER_RUN=10
PDF_OCR_ENABLED=false
PDF_OCR_MAX_PAGES=25

# Operational telemetry. Leave blank to disable protected /metrics access.
METRICS_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Do not enable REQUIRE_HMAC until the Core API sends the documented signature,
# timestamp and nonce headers. Keep HMAC_SHARED_SECRET server-side only.
