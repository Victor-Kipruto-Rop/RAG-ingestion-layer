# SAFE LOCAL DEVELOPMENT DEFAULTS ONLY.
# Copy this file to .env for Windows local testing.
# Do not put production Supabase URLs, database passwords, or R2 keys here.
APP_ENV=development
APP_NAME=PesaGuard Registry Datasource
DATABASE_URL=sqlite:///./registry.db
# Replace with a long random LOCAL-ONLY key before starting the stack.
REGISTRY_API_KEYS=change-this-local-only-key-before-use
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800
MAX_RECORDS_PER_FILE=1000000
LOCAL_STORAGE_PATH=./.registry-uploads
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=30
WORKER_STALE_AFTER_SECONDS=900
WORKER_MAX_JOBS_PER_RUN=10
# Intentionally blank for local-only testing. The Windows compose file overrides
# database and storage paths and explicitly blanks these settings in containers.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
VITE_API_BASE_URL=http://localhost:8000
