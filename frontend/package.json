{
  "name": "pesaguard-registry-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "pages:preview": "npx --yes wrangler pages dev dist --config wrangler.jsonc",
    "pages:deploy:staging": "node ./scripts/deploy-pages-staging.mjs",
    "pages:deploy:production": "node ./scripts/deploy-pages-production.mjs",
    "pages:check": "node ./scripts/verify-pages-build.mjs",
    "pages:build": "npm run build && npm run pages:check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
