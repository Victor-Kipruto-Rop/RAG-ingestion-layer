# Private datasource runtime settings. Copy to .env.production and chmod 600.
APP_ENV=production
API_ENVIRONMENT=production
REGISTRY_DB_NAME=pesaguard_registry
REGISTRY_DB_USER=pesaguard_registry
REGISTRY_DB_PASSWORD=REPLACE_WITH_UNIQUE_URI_SAFE_HEX_SECRET
REGISTRY_API_KEYS=REPLACE_WITH_SHARED_API_KEY_FROM_OPERATIONS_ENV
CORS_ORIGINS=https://app.pesaguard.co.ke
PUBLIC_BASE_URL=https://registry.pesaguard.co.ke
ADMIN_FRONTEND_URL=https://registry.pesaguard.co.ke
# Cloudflare R2 private bucket. Keep this bucket in the approved jurisdiction.
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
R2_BUCKET_NAME=REPLACE_WITH_PRIVATE_BUCKET
R2_ENDPOINT_URL=
REDIS_URL=redis://registry-redis:6379/0
# API key authentication is the service boundary; enable HMAC only after the
# API client signs the exact documented canonical request format.
REQUIRE_HMAC=false
HMAC_SHARED_SECRET=
API_KEY_AUTH_JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
API_KEY_AUTH_JWT_ISSUER=pesaguard-api
API_KEY_AUTH_JWT_AUDIENCE=pesaguard-registry
API_KEY_AUTH_JWT_ACTIVE_KID=v1
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
AUTH_OTP_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM_EMAIL=Registry Operations <no-reply@pesaguard.co.ke>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADMIN_OAUTH_ALLOWED_EMAILS=
ADMIN_SIGNUP_ALLOWED_EMAILS=
DEVELOPER_ACCESS_TOKEN_SECRET=
DEVELOPER_WEBHOOK_ENCRYPTION_KEY=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
